# Menakan HRMS environment configuration. Copy to .env and edit.
APP_NAME="Menakan Transport HR Portal"
APP_ENV=local
APP_DEBUG=false
# Public URL of the app, without a trailing slash
APP_URL=http://localhost:8080/menakan-hrms
# URL path the app is mounted on ("" when served from the domain root)
APP_BASE_PATH=/menakan-hrms
APP_TIMEZONE=Europe/London

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menakan_hrms
DB_USERNAME=menakan_app
DB_PASSWORD=change-me

SESSION_IDLE_MINUTES=30
SESSION_COOKIE=MTHRMSSID

# Mail: "log" writes messages to storage/logs/mail.log (nothing is delivered).
# Company webmail opened from the My Email menu (staff sign in there; no password is stored in the HRMS)
WEBMAIL_URL=https://ns3-777.333servers.com:2096/

# Set MAIL_DRIVER=smtp and fill in the SMTP_* values to actually send email (payslips, password links).
MAIL_DRIVER=log
MAIL_FROM=hr@menakantransport.com
MAIL_FROM_NAME="Menakan Transport HR"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls (port 587), ssl (port 465) or none
SMTP_ENCRYPTION=tls
