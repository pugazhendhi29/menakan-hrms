{
    "name": "menakan/hrms",
    "description": "Menakan Transport Ltd HR Management System",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-zip": "*",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.2",
        "tecnickcom/tcpdf": "^6.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
